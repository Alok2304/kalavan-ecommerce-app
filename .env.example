# Supabase project settings. The service role key must stay server-side.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Clerk Dashboard webhook endpoint: https://your-domain/api/webhooks/clerk
# Subscribe to user.created, user.updated, and user.deleted.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_webhook_signing_secret

# Comma-separated Clerk user IDs that receive the admin role on profile sync.
CLERK_ADMIN_USER_IDS=user_id_from_clerk_dashboard

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
